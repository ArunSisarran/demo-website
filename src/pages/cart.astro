---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const drinks = await getCollection('drinks');
const catalog = Object.fromEntries(
  await Promise.all(
    drinks.map(async (d) => {
      const thumb = await getImage({ src: d.data.image, width: 128, height: 160, format: 'webp' });
      return [d.id, {
        name: d.data.name,
        price: d.data.price,
        abv: d.data.abv ?? '',
        thumb: thumb.src,
        alt: d.data.alt,
      }];
    }),
  ),
);
---

<Base
  title="Your cart — Cellar & Vine"
  description="Review what you have picked before checking out."
  cartDrawer={false}
>
  <div class="mx-auto max-w-page px-6 pt-16 pb-24 md:px-10 md:pt-24 md:pb-32">
    <div class="flex items-center gap-4">
      <span class="h-px w-10 bg-brand/40"></span>
      <p class="eyebrow text-brand/75">Cart</p>
    </div>

    <h1 class="mt-8 text-brand">
      <span class="block font-body text-[clamp(2rem,5vw,3.5rem)] leading-none italic">Your</span>
      <span class="block font-display text-[clamp(2.5rem,7vw,5rem)] leading-[0.95] uppercase">Round</span>
    </h1>

    <div class="mt-14 grid gap-16 lg:grid-cols-[1.5fr_1fr] lg:items-start">
      <div>
        <ul class="divide-y divide-brand/15 border-y border-brand/15" data-lines></ul>

        <p class="py-12 text-ink/75" data-empty hidden>
          Nothing in the cart yet. <a class="text-brand underline decoration-brand/30 underline-offset-4 hover:decoration-brand" href="/menu">Have a look at the list</a>.
        </p>
      </div>

      <aside class="rounded-3xl border border-brand/15 bg-paper-sunk/60 p-8" data-summary hidden>
        <p class="eyebrow text-brand/75">Summary</p>

        <dl class="mt-6 space-y-3">
          <div class="flex justify-between gap-6">
            <dt class="text-ink/75">Subtotal</dt>
            <dd class="data text-base text-brand" data-subtotal>£0.00</dd>
          </div>
          <div class="flex justify-between gap-6">
            <dt class="text-ink/75">Service</dt>
            <dd class="data text-base text-ink/70">Included</dd>
          </div>
        </dl>

        <div class="mt-6 flex justify-between gap-6 border-t border-brand/15 pt-6">
          <p class="font-display text-lg tracking-[0.05em] text-brand uppercase">Total</p>
          <p class="data text-lg text-brand" data-total>£0.00</p>
        </div>

        <a href="/checkout" class="btn btn-primary mt-8 w-full justify-center">
          Checkout
          <span aria-hidden="true">&rarr;</span>
        </a>

        <p class="mt-5 text-[15px] text-ink/75">
          Collection only, from the bar at 14 Alder Lane. You pick a time at checkout.
          We don't deliver.
        </p>
        <p class="data mt-3 text-[11px] text-ink/70">Demo — no charge is taken.</p>
      </aside>
    </div>
  </div>


  <script>
    import { renderLines } from '../scripts/cart-render.js';

    const catalog = JSON.parse(document.getElementById('catalog').textContent);
    const lines = document.querySelector('[data-lines]');

    function render() {
      const { slugs, total } = renderLines(lines, catalog);
      const money = new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' }).format(total);
      document.querySelector('[data-empty]').hidden = slugs.length > 0;
      document.querySelector('[data-summary]').hidden = slugs.length === 0;
      document.querySelector('[data-subtotal]').textContent = money;
      document.querySelector('[data-total]').textContent = money;
    }

    document.addEventListener('cart:change', render);
    render();
  </script>
</Base>
