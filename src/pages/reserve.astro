---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import OpenNow from '../components/OpenNow.astro';

const sizes = ['1 guest', '2 guests', '3 guests', '4 guests', '5 guests', '6 guests'];
---

<Base
  title="Reserve a table — Cellar & Vine"
  description="Book the four reservable seats, or the whole room for an evening. Fourteen seats total, most of them held for walk-ins."
>
  <div class="mx-auto max-w-page px-6 pt-16 pb-24 md:px-10 md:pt-24 md:pb-32">
    <div class="flex items-center gap-4">
      <span class="h-px w-10 bg-brand/40"></span>
      <p class="eyebrow text-brand/75">Reservations</p>
    </div>

    <div class="mt-10 grid gap-12 md:grid-cols-[1.1fr_1fr] md:items-end">
      <h1 class="text-brand">
        <span class="block font-body text-[clamp(2.5rem,7vw,5rem)] leading-none italic">Hold</span>
        <span class="block font-display text-[clamp(2.5rem,8vw,5.5rem)] leading-[0.95] uppercase">A Seat</span>
      </h1>
      <p class="border-l-2 border-accent pl-6 text-ink/75">
        Ten of the fourteen seats are kept for walk-ins, so we take a small number of
        bookings each evening. Tables are held for fifteen minutes.
      </p>
    </div>

    <div class="mt-16 grid gap-16 lg:grid-cols-[1.3fr_1fr] lg:items-start">
      <form
        name="reservation"
        method="POST"
        action="/thanks"
        data-netlify="true"
        netlify-honeypot="bot-field"
        novalidate
        data-validate
        class="space-y-8"
      >
        {/* Netlify needs the form name in the payload on a static build. */}
        <input type="hidden" name="form-name" value="reservation" />
        <p hidden>
          <label>Leave this empty: <input name="bot-field" /></label>
        </p>

        <div class="grid gap-6 sm:grid-cols-2">
          <Field label="Date" name="date" type="date" required />
          <div class="min-w-0">
            <label class="field-label" for="f-time">Time</label>
            <select id="f-time" name="time" required class="field-input mt-2">
              <option value="">Pick a date first</option>
            </select>
            <p class="mt-1.5 text-[13px] text-ink/70" data-slot-note>
              Only the hours we’re open show here.
            </p>
            <p class="field-error mt-1.5" aria-live="polite"></p>
          </div>
        </div>

        <Field label="Party size" name="party" options={sizes} required class="sm:max-w-xs" />

        <div class="grid gap-6 sm:grid-cols-2">
          <Field label="Name" name="name" required autocomplete="name" />
          <Field label="Email" name="email" type="email" required autocomplete="email" inputmode="email" />
        </div>

        <Field label="Phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />

        <Field
          label="Anything we should know" name="notes" rows={4}
          placeholder="Allergies, a birthday, a table preference."
        />

        <button type="submit" class="btn btn-primary">
          Request the table
          <span aria-hidden="true">&rarr;</span>
        </button>

        <p class="data text-[11px] text-ink/70">
          Demo — this posts to a form handler and books nothing.
        </p>
      </form>

      <aside class="rounded-3xl border border-brand/15 bg-paper-sunk/60 p-8">
        <p class="eyebrow text-brand/75">Before you book</p>
        <ul class="mt-6 space-y-5 text-[15px] text-ink/75">
          <li>Parties of seven or more take the whole back room — email us instead.</li>
          <li>We hold the table for fifteen minutes, then it goes to the door.</li>
          <li>The kitchen is small plates only, and it stops an hour before we close.</li>
          <li>Last bookable slot is 22:00, later on Thursday through Saturday.</li>
        </ul>

        <p class="eyebrow mt-10 text-brand/75">Hours</p>
        <OpenNow variant="block" class="mt-4" />
      </aside>
    </div>
  </div>

  <script>
    import { enhance } from '../scripts/forms.js';
    import { bindSlots, todayISO } from '../scripts/slots.js';

    const form = document.querySelector('[data-validate]');
    enhance(form);

    // Past dates are blocked at the input, not just on submit. Set at runtime
    // because a static build's "today" goes stale the day after it deploys.
    const date = form.elements.date;
    date.min = todayISO();

    const note = document.querySelector('[data-slot-note]');
    bindSlots(date, form.elements.time, { markBooked: true });
    form.elements.time.addEventListener('slots:filled', (event) => {
      const { free, total } = event.detail;
      note.textContent =
        free === 0
          ? 'Fully booked that day — try another, or just walk in.'
          : `${free} of ${total} slots still free.`;
    });

    // Hand the details to /thanks so the confirmation can repeat them back.
    form.addEventListener('submit', () => {
      if (!form.checkValidity()) return;
      sessionStorage.setItem('cv-booking', JSON.stringify({
        date: form.elements.date.value,
        time: form.elements.time.value,
        party: form.elements.party.value,
        name: form.elements.name.value,
      }));
    });
  </script>
</Base>
