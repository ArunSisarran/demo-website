---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DrinkRow from '../../components/DrinkRow.astro';

export async function getStaticPaths() {
  const drinks = await getCollection('drinks');
  return drinks.map((drink) => ({
    params: { slug: drink.id },
    props: { drink, drinks },
  }));
}

const { drink, drinks } = Astro.props;
const {
  name, category, price, abv, note, badges, pairing, image, alt,
  serve, allergens, ingredients, available, availableNote,
} = drink.data;
const { Content } = await render(drink);

const alsoTry = drinks
  .filter((d) => d.data.category === category && d.id !== drink.id)
  .slice(0, 2);
---

<Base title={`${name} — Cellar & Vine`} description={note} ogImage={`/og/drinks/${drink.id}.jpg`} cartBar>
  <article class="mx-auto max-w-page px-6 pt-12 pb-24 md:px-10 md:pt-20 md:pb-32">
    <a href="/menu" class="eyebrow text-brand/75 transition-colors hover:text-brand">
      <span aria-hidden="true">&larr;</span> Back to the menu
    </a>

    <div class="mt-10 grid gap-14 md:grid-cols-2 md:gap-20">
      <div class="napkin p-4 md:sticky md:top-28 md:self-start">
        <Image
          src={image}
          alt={alt}
          width={900}
          height={1200}
          widths={[450, 700, 900]}
          sizes="(min-width: 768px) 44vw, 92vw"
          class="aspect-3/4 w-full rounded-xl object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div>
        <p class="eyebrow text-brand/75">{category}</p>

        <h1 class="mt-5 font-display text-[clamp(2.25rem,6vw,4rem)] leading-[1.05] text-brand uppercase">
          {name}
        </h1>

        <p class="mt-5 text-xl leading-snug text-ink/75 italic">{note}</p>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 border-y border-brand/15 py-4">
          <span class="data text-lg text-brand tabular-nums">£{price.toFixed(2)}</span>
          <span class="tag text-ink/70">{serve}</span>
          {abv && <span class="tag text-ink/70">{abv}</span>}
          {badges.map((badge) => <span class="tag text-brand/75">{badge}</span>)}
        </div>

        {available ? (
          <div class="mt-8 flex flex-wrap items-center gap-4" data-row-controls={drink.id}>
            <button
              type="button"
              data-add={drink.id}
              class="btn btn-primary"
            >
              Add to order <span aria-hidden="true">&rarr;</span>
            </button>
            <div class="flex items-center gap-3" data-row-qty hidden>
              <button type="button" class="step" data-step="-1" data-slug={drink.id} aria-label={`One fewer ${name}`}>&minus;</button>
              <span class="data w-10 text-center text-lg text-brand" data-qty-for={drink.id}>0</span>
              <button type="button" class="step" data-step="1" data-slug={drink.id} aria-label={`One more ${name}`}>+</button>
              <a href="/cart" data-cart-link class="eyebrow ml-2 text-brand/75 underline underline-offset-4 hover:text-brand">In your order</a>
            </div>
            <button type="button" data-share class="btn btn-ghost">Share</button>
          </div>
        ) : (
          <div class="mt-8 rounded-2xl border border-brand/20 bg-paper-sunk/60 p-5">
            <p class="eyebrow text-brand/75">Off the list</p>
            <p class="mt-2 text-ink/75">{availableNote}. It will come back on the menu when it does.</p>
          </div>
        )}

        <div class="prose-body mt-8 max-w-prose space-y-5 text-ink/75">
          <Content />
        </div>

        <div class="mt-10 rounded-2xl border border-brand/15 bg-paper-sunk/50 p-6">
          <p class="eyebrow text-brand/75">What's in it</p>
          <p class="mt-3 text-ink/75">{ingredients}</p>

          <p class="eyebrow mt-6 text-brand/75">Allergens</p>
          <p class="mt-3 text-ink/75">
            {allergens.length > 0
              ? `Contains ${allergens.join(', ').toLowerCase()}.`
              : 'None of the fourteen listed allergens.'}
          </p>
          <p class="mt-2 text-[15px] text-ink/70">
            Made in a bar that also handles nuts, dairy and gluten, so we cannot promise no
            trace. If it matters, tell whoever is serving you and they will talk it through.
          </p>
        </div>

        {pairing && (
          <div class="mt-10 border-l-2 border-accent pl-6">
            <p class="eyebrow text-brand/75">Goes with</p>
            <p class="mt-2 text-ink/75">{pairing}</p>
          </div>
        )}

        <p class="data mt-10 text-[11px] text-ink/70">
          Demo — collection only, and no payment is ever taken.
        </p>
      </div>
    </div>

    {alsoTry.length > 0 && (
      <section class="mt-24 border-t border-brand/15 pt-12">
        <h2 class="eyebrow text-brand/75">Also on the {category.toLowerCase()} list</h2>
        <ul class="mt-6 grid gap-x-16 md:grid-cols-2">
          {alsoTry.map((d) => <DrinkRow drink={d} />)}
        </ul>
      </section>
    )}
  </article>
  <script>
    // Native share where it exists, clipboard everywhere else.
    const button = document.querySelector('[data-share]');
    if (button) {
      button.addEventListener('click', async () => {
        const share = { title: document.title, text: document.querySelector('meta[name=description]')?.content, url: location.href };
        try {
          if (navigator.share) { await navigator.share(share); return; }
          await navigator.clipboard.writeText(location.href);
          const original = button.textContent;
          button.textContent = 'Link copied';
          setTimeout(() => { button.textContent = original; }, 1600);
        } catch {
          /* Dismissed the share sheet, or clipboard denied — nothing to do. */
        }
      });
    }
  </script>
</Base>
