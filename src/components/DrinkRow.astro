---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  drink: CollectionEntry<'drinks'>;
  /** Menu and home rows can add to the cart; "also try" rows just navigate. */
  addable?: boolean;
}
const { drink, addable = true } = Astro.props;
const { name, price, abv, note, badges, category, image, alt, serve, allergens, available, availableNote } =
  drink.data;
---

<li
  data-cat={category}
  data-name={name.toLowerCase()}
  data-price={price}
  data-new={badges.includes('New') ? '' : null}
  data-allergens={allergens.join(',')}
  data-reveal
  class:list={['group relative flex gap-5 py-5', !available && 'is-off']}
>
  <div class="napkin drink-media shrink-0 self-start p-2">
    <Image
      src={image}
      alt={alt}
      width={192}
      height={256}
      widths={[96, 192, 288]}
      sizes="(min-width: 640px) 96px, 80px"
      class="h-24 w-20 rounded-md object-cover sm:h-28 sm:w-24"
      loading="lazy"
    />
  </div>

  <div class="flex min-w-0 flex-1 flex-col">
    <div class="flex items-baseline gap-3">
      <h3 class="font-display text-lg tracking-[0.05em] text-brand uppercase">
        <a href={`/menu/${drink.id}`} class="after:absolute after:inset-0 after:rounded-2xl">
          {name}
        </a>
      </h3>
      <span class="hidden h-px flex-1 bg-brand/15 sm:block"></span>
      <span class="data text-base text-brand tabular-nums">£{price.toFixed(2)}</span>
    </div>

    <p class="mt-1.5 max-w-prose text-[15px] text-ink/75 italic">{note}</p>

    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
      <span class="tag text-ink/70">{serve}</span>
      {abv && <span class="tag text-ink/70">{abv}</span>}
      {badges.map((badge) => <span class="tag text-brand/75">{badge}</span>)}
      {allergens.length > 0 && (
        <span class="tag text-ink/70">Contains {allergens.join(' · ')}</span>
      )}
    </div>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-x-4 gap-y-2 pt-3">
      {available ? (
        addable && (
          <div class="relative z-10" data-row-controls={drink.id}>
            <button
              type="button"
              data-add={drink.id}
              class="chip hover:border-accent hover:bg-accent hover:text-brand-dk"
            >
              Add
            </button>
            <div class="flex items-center gap-2" data-row-qty hidden>
              <button type="button" class="step" data-step="-1" data-slug={drink.id} aria-label={`One fewer ${name}`}>&minus;</button>
              <span class="data w-8 text-center text-base text-brand" data-qty-for={drink.id}>0</span>
              <button type="button" class="step" data-step="1" data-slug={drink.id} aria-label={`One more ${name}`}>+</button>
            </div>
          </div>
        )
      ) : (
        <p class="tag relative z-10 rounded-full border border-brand/20 px-3 py-2 text-ink/70">
          Off the list — {availableNote}
        </p>
      )}
    </div>
  </div>
</li>
