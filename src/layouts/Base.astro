---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartBar from '../components/CartBar.astro';
import CartDrawer from '../components/CartDrawer.astro';

interface Props {
  title: string;
  description: string;
  /** Home lays a dark hero under a transparent header; inner pages don't. */
  transparentHeader?: boolean;
  /** Link-preview image, absolute path under /og. */
  ogImage?: string;
  /** Shows the thumb-reachable cart bar on small screens. */
  cartBar?: boolean;
  /** The cart and checkout pages ARE the cart; they don't need the drawer. */
  cartDrawer?: boolean;
}

const {
  title,
  description,
  transparentHeader = false,
  ogImage = '/og/default.jpg',
  cartBar = false,
  cartDrawer = true,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// One catalog for the whole site: the cart, the checkout summary, and the
// sticky mobile bar all read this rather than each emitting their own copy.
const drinks = await getCollection('drinks');
const catalog = Object.fromEntries(
  await Promise.all(
    drinks.map(async (d) => {
      const thumb = await getImage({ src: d.data.image, width: 128, height: 160, format: 'webp' });
      return [d.id, {
        name: d.data.name,
        price: d.data.price,
        abv: d.data.abv ?? '',
        thumb: thumb.src,
        alt: d.data.alt,
      }];
    }),
  ),
);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Cellar & Vine" />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#12261f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Only the two faces that paint above the fold are preloaded. */}
    <link rel="preload" href="/fonts/ArchivoBlack-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Jost-400.woff2" as="font" type="font/woff2" crossorigin />
    {/* Before the body exists, so the browser's own scroll restoration is not
        clamped by a document that has not been built yet. The readout showed it
        landing 44px short here and being corrected later; on a phone the gap
        can be larger, and whatever is painted before the correction is the
        flash of somewhere else. Giving the page its remembered height up front
        means the browser's restore is right the first time. */}
    <script is:inline>
      (function () {
        try {
          var entry = performance.getEntriesByType('navigation')[0];
          if (!entry || entry.type !== 'back_forward') return;
          var st = history.state;
          if (!st || typeof st.cvH !== 'number') return;
          var root = document.documentElement;
          root.style.minHeight = st.cvH + 'px';
          // Clears itself: the body script only registers a cleanup when it
          // sets the height too, and it will not if this already did.
          addEventListener('load', function () {
            root.style.minHeight = '';
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="eyebrow sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-paper focus:px-5 focus:py-3 focus:text-brand"
    >
      Skip to content
    </a>
    <Header transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {cartBar && <CartBar />}
    {cartDrawer && <CartDrawer />}

    <script type="application/json" id="catalog" set:html={JSON.stringify(catalog)}></script>

    {/* Cart count is announced, not just colored. */}
    <p class="sr-only" role="status" aria-live="polite" data-cart-announce></p>

    <script>
      import { add, count, read } from '../scripts/cart.js';
      import { bindLineControls } from '../scripts/cart-render.js';

      bindLineControls();

      const paint = () => {
        const n = count();
        document.querySelectorAll('[data-cart-count]').forEach((badge) => {
          badge.textContent = String(n);
          badge.toggleAttribute('hidden', n === 0);
        });

        // A row you've already added shows a stepper instead of "Add", so you
        // can adjust the quantity without opening anything.
        const cart = read();
        document.querySelectorAll('[data-row-controls]').forEach((row) => {
          const slug = row.dataset.rowControls;
          const qty = cart[slug] || 0;
          const button = row.querySelector('[data-add]');
          const stepper = row.querySelector('[data-row-qty]');
          if (!button || !stepper) return;
          button.hidden = qty > 0;
          stepper.hidden = qty === 0;
          const value = stepper.querySelector(`[data-qty-for="${slug}"]`);
          if (value) value.textContent = String(qty);
        });
      };

      // One delegated listener covers every Add button on every page.
      document.addEventListener('click', (event) => {
        const button = event.target instanceof Element && event.target.closest('[data-add]');
        if (!(button instanceof HTMLElement)) return;
        add(button.dataset.add);
        const announce = document.querySelector('[data-cart-announce]');
        if (announce) announce.textContent = `Added to cart. ${count()} items.`;
      });

      document.addEventListener('cart:change', paint);
      paint();
    </script>

    <script>
      // A back link should step back, not load a fresh copy of where you came
      // from — going back restores your scroll position, any filter you had
      // set, and plays the view transition in reverse, so the drink page reads
      // as something that opened over the list and closed again.
      //
      // `data-back` is strict: it steps back only when the page it points at
      // is the one you arrived from, so a link that names its destination
      // ("Back to the cart") can never send you somewhere else.
      // `data-back="any"` is for a link that only says "Back" — it returns you
      // wherever you came from, which for a drink is the home list or the menu
      // depending on how you got in.
      //
      // Either way a direct arrival, a shared link, or a modifier-click still
      // navigates to the href, so the link works with JavaScript off.
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element && event.target.closest('[data-back]');
        if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        const tidy = (path) => path.replace(/\/+$/, '') || '/';
        let from;
        try {
          from = new URL(document.referrer);
        } catch {
          return; // No referrer: nothing to go back to.
        }
        if (from.origin !== location.origin) return;
        if (link.getAttribute('data-back') !== 'any' &&
            tidy(from.pathname) !== tidy(new URL(link.href).pathname)) return;
        event.preventDefault();
        history.back();
      });
    </script>

    <script>
      // Fade + 16px rise, once, staggered across siblings. The hiding CSS is
      // gated on this attribute, so without JS everything is simply visible.
      // Where the browser can scrub this from scroll position itself, the CSS
      // owns it and none of the following runs at all.
      const cssDrivesIt = CSS.supports('animation-timeline', 'view()');
      const targets = document.querySelectorAll('[data-reveal]');
      if (targets.length && !cssDrivesIt && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.setAttribute('data-reveal-ready', '');
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        for (const target of targets) {
          const siblings = [...target.parentElement.querySelectorAll(':scope > [data-reveal]')];
          target.style.transitionDelay = `${Math.min(siblings.indexOf(target), 5) * 60}ms`;
          observer.observe(target);
        }
      }
    </script>
    {/* Classic and last: not a module, because `pagereveal` fires before
        deferred scripts run and a listener registered from one would miss the
        navigation it exists to handle; and at the end of the body, because it
        needs the rows parsed to find the one it has to name. */}
    <script is:inline>
      // Exactly one photo takes part in the morph: the drink you clicked.
      //
      // Naming every row instead would animate the whole list — rows with a
      // counterpart on the other page travel across the screen, and rows
      // without one fade out on their own, over the group's duration rather
      // than the page's. Both read as the page being busy.
      //
      // So the drink page names its hero, nothing else does, and a row is
      // named only while a navigation is actually happening.
      (function () {
        var HERO = 'vt-hero';
        var KEY = 'cv-morph';

        // Arriving backwards? Then this page has already been read, and the
        // CSS drops it straight to its settled state — no entrance replays.
        // Set before the first render, so there is no frame of
        // animated-then-corrected.
        function markReturn() {
          document.documentElement.setAttribute('data-returning', '');
        }
        var entry = performance.getEntriesByType('navigation')[0];
        var returning = !!entry && entry.type === 'back_forward';
        if (returning) markReturn();
        addEventListener('pageshow', function (event) {
          if (event.persisted) markReturn();
        });

        // Land on the scroll position before the first paint, not after it.
        //
        // The browser restores scroll on a traversal by itself, but WebKit
        // does it late enough that one frame of the top of the page gets
        // painted first. So we put the position on the history entry as we
        // leave, and put it back synchronously here, while this script is
        // still blocking the first render.
        //
        // Deliberately *in addition to* the browser's own restoration rather
        // than instead of it: `scrollRestoration = 'manual'` would hand us the
        // whole job, and if our value were ever missing the reader would land
        // at the top of the page. This way the browser still corrects us a
        // moment later, so the worst case is the flash we already had.
        function remember() {
          try {
            var st = history.state || {};
            var y = Math.round(scrollY);
            var h = document.documentElement.scrollHeight;
            if (st.cvY !== y || st.cvH !== h) {
              history.replaceState(Object.assign({}, st, { cvY: y, cvH: h }), '');
            }
          } catch (e) {}
        }
        addEventListener('pagehide', remember);

        if (returning) {
          var st = history.state || {};
          if (typeof st.cvY === 'number' && st.cvY > 0) {
            // No scroll anchoring while we do it. Fonts swap in after the
            // first paint, the text above the viewport grows, and anchoring
            // shifts the page to compensate — then the browser's own
            // restoration undoes the shift, so the reader gets a bounce.
            var root = document.documentElement;
            root.style.overflowAnchor = 'none';
            addEventListener('load', function () {
              root.style.overflowAnchor = '';
            });
            // `behavior: instant` is not optional: the stylesheet sets
            // `scroll-behavior: smooth` for in-page anchors, and a plain
            // scrollTo inherits it — which animates the page down from the top
            // instead of putting it there.
            scrollTo({ top: st.cvY, left: 0, behavior: 'instant' });
          }
        }

        function slugOf(url) {
          if (!url) return '';
          try {
            var u = new URL(url, location.href);
            if (u.origin !== location.origin) return '';
            var m = u.pathname.match(/^\/menu\/([^/]+)\/?$/);
            return m ? m[1] : '';
          } catch (e) {
            return '';
          }
        }

        function rowFor(slug) {
          if (!slug) return null;
          var link = document.querySelector('a[href="/menu/' + slug + '"]');
          var li = link && link.closest('li');
          return (li && li.querySelector('.napkin')) || null;
        }

        function holder() {
          return document.querySelector('.' + HERO);
        }

        function get() {
          try { return sessionStorage.getItem(KEY) || ''; } catch (e) { return ''; }
        }
        function put(value) {
          try { sessionStorage.setItem(KEY, value); } catch (e) {}
        }

        // Leaving: the row being opened takes the name, even if the hero of
        // the page we are leaving holds it — clicking an "also try" drink
        // should grow that thumbnail, not the hero we are abandoning. Two
        // elements sharing a name is an error the browser answers by dropping
        // the transition, so the handover is explicit rather than additive.
        //
        // Read off the clicked link, NOT off `pageswap`: that event carries
        // the destination as a NavigationActivation, which is part of the
        // Navigation API and does not exist in Safari. Taking it from the
        // link works in every browser that has view transitions at all.
        document.addEventListener('click', function (event) {
          var link = event.target instanceof Element && event.target.closest('a[href^="/menu/"]');
          if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
          var slug = slugOf(link.href);
          if (!slug) return;
          var row = rowFor(slug);
          if (!row) return;
          var current = holder();
          if (current === row) return;
          if (current) current.classList.remove(HERO);
          row.classList.add(HERO);
        }, true);

        var arrived = false;
        function arrive() {
          if (arrived) return;
          arrived = true;
          var pending = get();
          put(''); // Single use: a later, unrelated hop must not name anything.
          // Arriving only ever fills an empty slot. A drink page already names
          // its hero and has to keep it, or the pair is nonsense.
          if (pending && !holder()) {
            var row = rowFor(pending);
            if (row) row.classList.add(HERO);
          }
          // Arm the return trip, so the list we go back to knows which row
          // this page should shrink into.
          var self = slugOf(location.href);
          if (self) put(self);
        }

        // Synchronously, right here. This script is the last thing in the body,
        // so every row is already parsed — and being before the first render
        // is what matters: WebKit captures the incoming page's state at
        // `pagereveal`, so a name applied any later than this simply is not in
        // the snapshot and there is nothing for the hero to morph into.
        // Chromium is lenient about this and captures later, which is why
        // deferring it worked on the desktop and silently did nothing on iOS.
        arrive();

        // A page restored from the back/forward cache does not re-run scripts,
        // so it keeps the name it was given on the way out — but the stored
        // slug still needs consuming and re-arming for the next trip.
        addEventListener('pageshow', function (event) {
          if (!event.persisted) return;
          arrived = false;
          arrive();
        });
      })();
    </script>
  </body>
</html>
